# Streamlit Cloud / local secrets template.
# Copy to .streamlit/secrets.toml (never commit secrets.toml).

DEPLOY_MODE = "true"
OPENAI_API_KEY = "sk-your-openai-key-here"
GROQ_API_KEY = "gsk-your-groq-key-here"
GROQ_LLM_MODEL = "llama-3.3-70b-versatile"

# Public deploy defaults (Refresh brain disabled on cloud)
ENABLE_REFRESH_BRAIN = "false"
ASK_RATE_LIMIT = "10"
